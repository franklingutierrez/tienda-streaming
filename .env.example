# Copia este archivo como .env (o .env.local) y completa los valores reales.
# NUNCA subas .env a GitHub.

# Token de la integración de Notion (ntn_...)
NOTION_TOKEN=

# Contraseña del panel admin (admin.html). Usa una larga y única.
ADMIN_PASSWORD=

# Origen del frontend en GitHub Pages, sin ruta de repo.
# Varios orígenes separados por coma. Ej: https://usuario.github.io
ALLOWED_ORIGIN=https://TU-USUARIO.github.io

# Datos de Yape que verá el cliente
YAPE_NUMBER=999999999
YAPE_NAME=Tu Nombre
